'use strict';

import { access, opendir, readfile, popen } from 'fs';
import * as math from "math";
import * as rtnl from 'rtnl';
import * as uci from 'uci';

// The controller's WPA PSKs (incl. private PSKs with VLAN ids) are synced
// into the wifi-psk sections of /etc/config/wireless_psk (luci-mod-wifiext)
// for every local wifi-iface with a matching SSID. Being regular config,
// the last synced state stays in place as fallback without the controller.
const WPA_PSK_CONFIG = 'wireless_psk';
const WPA_PSK_RELOAD = '/etc/init.d/wireless_psk';
const WPA_PSK_NEW_COMMENT = 'UniFi';

let vap_id = {};      // ssid -> vap id, derived from systemcfg

// Collects the PSKs per SSID from the controller's 'aaa.N.*' (hostapd)
// settings. With private PSKs enabled (wpa.psk_file.status) only the
// psk_file entries are used - the WLAN's own wpa.psk is then just a
// random placeholder generated by the controller. Otherwise the single
// wpa.psk is exported without VLAN.
function get_wpa_psks(systemcfg) {
	let psks = {};
	let idxs = [];

	for (let key in keys(systemcfg)) {
		const m = match(key, /^aaa\.([0-9]+)\.ssid$/);
		if (m)
			push(idxs, +m[1]);
	}
	sort(idxs);

	for (let idx in idxs) {
		const pfx = `aaa.${idx}.`;
		const ssid = systemcfg[pfx + 'ssid'];

		// the same WLAN shows up once per radio
		if (psks[ssid] || systemcfg[pfx + 'status'] == 'disabled')
			continue;

		let list = [];
		if (systemcfg[pfx + 'wpa.psk_file.status'] == 'enabled') {
			for (let n = 1; systemcfg[`${pfx}wpa.psk_file.${n}.psk`] != null; n++)
				push(list, {
					vid: systemcfg[`${pfx}wpa.psk_file.${n}.vlanid`],
					psk: systemcfg[`${pfx}wpa.psk_file.${n}.psk`],
				});
		} else if (systemcfg[pfx + 'wpa.psk']) {
			push(list, { psk: systemcfg[pfx + 'wpa.psk'] });
		}

		if (length(list))
			psks[ssid] = list;
	}

	return psks;
}

function wpa_psk_add(ctx, e) {
	const name = ctx.add(WPA_PSK_CONFIG, 'wifi-psk');
	for (let opt in [ 'comment', 'mac', 'psk', 'vid', 'iface' ])
		if (e[opt] != null && e[opt] != '')
			ctx.set(WPA_PSK_CONFIG, name, opt, e[opt]);
}

function wpa_psk_set(ctx, name, opt, value) {
	if (value == null || value == '')
		ctx.delete(WPA_PSK_CONFIG, name, opt);
	else
		ctx.set(WPA_PSK_CONFIG, name, opt, value);
}

// Syncs the controller PSKs into the wifi-psk sections for all local
// wifi-ifaces (with wpa_psk_file) whose SSID is known to the controller
// ("managed" ifaces). Entries are matched by passphrase, so existing
// entries keep their comment and MAC; only their VLAN id and interface
// scope are adjusted. Entries for unmanaged ifaces are left alone. Since
// 'iface' holds a single interface, an entry that ends up valid for only
// some of the ifaces is split into one entry per iface.
// Records the ifaces managed by the controller in a named section
// ("config managed 'unifi'"), so the LuCI page can point them out
// without needing access to the unifi config (which holds secrets).
function wpa_psk_mark_managed(ctx, ifaces) {
	const stype = ctx.get(WPA_PSK_CONFIG, 'unifi');

	if (!length(ifaces)) {
		if (stype == null)
			return false;

		ctx.delete(WPA_PSK_CONFIG, 'unifi');
		return true;
	}

	const cur = ctx.get(WPA_PSK_CONFIG, 'unifi', 'iface');
	if (stype == 'managed' && type(cur) == 'array' && join(' ', cur) == join(' ', ifaces))
		return false;

	ctx.delete(WPA_PSK_CONFIG, 'unifi');
	ctx.set(WPA_PSK_CONFIG, 'unifi', 'managed');
	ctx.set(WPA_PSK_CONFIG, 'unifi', 'iface', ifaces);
	return true;
}

// Instance options (see luci-app-unifi):
//   option psk_sync '0'      disable the sync completely (default: enabled)
//   list psk_ssid '<ssid>'   only sync these SSIDs (default: all SSIDs of
//                            the controller that also exist locally)
// SSIDs no longer synced keep their last synced entries as local config.
function wpa_psk_selected(cfg, systemcfg) {
	const psks = get_wpa_psks(systemcfg);

	if (cfg.psk_sync in [ '0', 'false', 'no', 'off', 'disabled' ])
		return {};

	if (cfg.psk_ssid == null)
		return psks;

	const allowed = (type(cfg.psk_ssid) == 'array') ? cfg.psk_ssid : [ cfg.psk_ssid ];
	let selected = {};
	for (let ssid, list in psks)
		if (ssid in allowed)
			selected[ssid] = list;

	return selected;
}

function sync_wpa_psks(API, cfg, systemcfg, confdir, savedir) {
	const unifi = wpa_psk_selected(cfg, systemcfg);
	const ctx = uci.cursor(confdir, savedir);
	if (!ctx.get_all(WPA_PSK_CONFIG))
		return false;   // luci-mod-wifiext not installed

	let all = [];
	let want = {};       // ifname -> { psk: vid }
	ctx.foreach('wireless', 'wifi-iface', function(s) {
		if (!s.wpa_psk_file || !s.ifname || s.ifname in all)
			return;

		push(all, s.ifname);

		const list = unifi[s.ssid];
		if (!list)
			return;

		want[s.ifname] = {};
		for (let e in list)
			if (!exists(want[s.ifname], e.psk))
				want[s.ifname][e.psk] = e.vid ?? '';
	});

	// without managed ifaces the loops below leave everything unchanged
	let changed = wpa_psk_mark_managed(ctx, sort(keys(want)));

	let entries = [];
	ctx.foreach(WPA_PSK_CONFIG, 'wifi-psk', s => push(entries, s));

	let covered = {};    // ifname -> { psk: true }
	let added = [];

	for (let e in entries) {
		const name = e['.name'];
		const scope = e.iface ? [ e.iface ] : all;
		let keep = [];
		let groups = {};    // vid -> [ ifname ]

		for (let i in scope) {
			if (!want[i]) {
				push(keep, i);          // not managed by the controller
				continue;
			}

			if (!exists(want[i], e.psk))
				continue;               // removed on the controller

			covered[i] ??= {};
			covered[i][e.psk] = true;

			const v = want[i][e.psk];
			groups[v] ??= [];
			push(groups[v], i);
		}

		let vid = e.vid ?? '';
		if (!length(keep) && !groups[vid] && length(groups))
			vid = keys(groups)[0];

		for (let i in (groups[vid] ?? []))
			push(keep, i);

		// same passphrase, but a different VLAN on some managed ifaces
		for (let v, ifs in groups)
			if (v != vid)
				for (let i in ifs)
					push(added, { comment: e.comment, mac: e.mac, psk: e.psk, vid: v, iface: i });

		if (!length(keep)) {
			API.dbg(`unifi: wireless_psk: removing '${e.comment ?? name}'\n`);
			ctx.delete(WPA_PSK_CONFIG, name);
			changed = true;
			continue;
		}

		if (vid != (e.vid ?? '')) {
			API.dbg(`unifi: wireless_psk: '${e.comment ?? name}' vid ${e.vid} -> ${vid}\n`);
			wpa_psk_set(ctx, name, 'vid', vid);
			changed = true;
		}

		if (length(keep) != length(scope)) {
			API.dbg(`unifi: wireless_psk: '${e.comment ?? name}' restricted to ${keep}\n`);
			wpa_psk_set(ctx, name, 'iface', keep[0]);
			for (let i in slice(keep, 1))
				push(added, { comment: e.comment, mac: e.mac, psk: e.psk, vid, iface: i });
			changed = true;
		}
	}

	// passphrases not configured yet, merged into one entry without
	// iface if they apply to all ifaces with the same VLAN
	let missing = {};    // psk -> vid -> [ ifname ]
	for (let i, psks in want) {
		for (let psk, vid in psks) {
			if (covered[i]?.[psk])
				continue;

			missing[psk] ??= {};
			missing[psk][vid] ??= [];
			push(missing[psk][vid], i);
		}
	}

	for (let psk, vids in missing) {
		for (let vid, ifs in vids) {
			if (length(ifs) == length(all))
				push(added, { comment: WPA_PSK_NEW_COMMENT, psk, vid });
			else
				for (let i in ifs)
					push(added, { comment: WPA_PSK_NEW_COMMENT, psk, vid, iface: i });
		}
	}

	for (let e in added) {
		API.dbg(`unifi: wireless_psk: adding '${e.comment}' vid ${e.vid} iface ${e.iface ?? '*'}\n`);
		wpa_psk_add(ctx, e);
		changed = true;
	}

	if (!changed)
		return false;

	ctx.commit(WPA_PSK_CONFIG);
	warn('unifi: wireless_psk config updated from controller\n');

	if (!confdir && access(WPA_PSK_RELOAD, 'x'))
		system(`${WPA_PSK_RELOAD} reload`);

	return true;
}

// Radio settings from the controller (radio.N.*, with phyname = the local
// wifi-device name), applied when enabled per instance:
//   option radio_sync '1'   (default: off)
// Applied are the channel (or 'auto'), for 'auto' the allowed channels
// (all available ones minus the controller's blklst) and DFS usage, the
// channel width (keeping the local htmode family HT/VHT/HE/EHT) and the
// transmit power.
const TRUE_VALUES = [ '1', 'true', 'yes', 'on', 'enabled' ];
const HT_MAX_WIDTH = { HT: 40, VHT: 160, HE: 160, EHT: 320 };

/* ---------------------------------------------------------------------- */
/* radio capabilities, probed once per phy                                */
/* ---------------------------------------------------------------------- */

let phy_caps = {};

function popcount(n) {
	let c = 0;
	for (; n > 0; n >>= 1)
		c += n & 1;
	return c;
}

function cmd_output(cmd) {
	const p = popen(cmd);
	if (!p)
		return '';
	const out = p.read('all') ?? '';
	p.close();
	return out;
}

// { phy, channels[], has_dfs, nss, min_txpower, max_txpower, htmodes[] }
// for the radio of a wireless interface, or null if it isn't up.
//  - channels: supported in the regulatory domain. The per-channel
//    'restricted'/flags of iwinfo are not used: they are unreliable on
//    some builds (e.g. the operating channel itself reported as no_ir),
//    and hostapd enforces the regulatory rules anyway.
//  - nss: spatial streams = configured TX antennas, else the highest
//    HT MCS index (8 per stream)
function radio_caps(API, ifname) {
	const info = API.ubus.call('iwinfo', 'info', { device: ifname });
	const phy = info?.phy;
	if (!phy)
		return null;

	if (phy_caps[phy])
		return phy_caps[phy];

	let caps = { phy, htmodes: info.htmodes ?? [], nss: 1 };

	const fl = API.ubus.call('iwinfo', 'freqlist', { device: ifname });
	caps.channels = map(fl?.results ?? [], f => f.channel);
	caps.has_dfs = length(filter(caps.channels, c => c >= 52 && c <= 144)) > 0;

	const iw = cmd_output(`iw phy ${phy} info 2>/dev/null`);
	const ant = match(iw, /Configured Antennas: TX 0x([0-9a-fA-F]+)/) ?? match(iw, /Available Antennas: TX 0x([0-9a-fA-F]+)/);
	const mcs = match(iw, /HT TX\/RX MCS rate indexes supported: 0-([0-9]+)/);
	if (ant && popcount(hex(ant[1])) > 0)
		caps.nss = popcount(hex(ant[1]));
	else if (mcs)
		caps.nss = int((+mcs[1] + 1) / 8) || 1;

	let dbm = [];
	for (let l in split(cmd_output(`iwinfo ${ifname} txpowerlist 2>/dev/null`), '\n')) {
		const m = match(l, /^[ \t*]*([0-9]+) dbm/i);
		if (m)
			push(dbm, +m[1]);
	}
	if (length(dbm)) {
		caps.min_txpower = min(...dbm);
		caps.max_txpower = max(...dbm);
	}

	// only cache complete results, a radio coming up may lack some
	if (length(caps.channels) && length(dbm))
		phy_caps[phy] = caps;

	return caps;
}

// caps of a wifi-device (via its first interface that is up)
function device_caps(API, wstat, radio) {
	for (let iface in (wstat?.[radio]?.interfaces ?? [])) {
		const ifname = iface.ifname ?? iface.config?.ifname;
		const caps = ifname ? radio_caps(API, ifname) : null;
		if (caps)
			return caps;
	}

	return null;
}

function has_htmode(caps, re) {
	return length(filter(caps?.htmodes ?? [], m => match(m, re))) > 0;
}

// Transmit power for the controller's txpower / txpower_mode: a number is
// used as is (clamped to the radio's range), 'auto'/'high' leave it to the
// driver (maximum), 'medium'/'low' are 3/6 dB below the maximum.
function txpower_wanted(systemcfg, pfx, caps) {
	const tp = systemcfg[pfx + 'txpower'];
	const mode = systemcfg[pfx + 'txpower_mode'];

	if (tp != null && match(tp, /^[0-9]+$/)) {
		let v = +tp;
		if (caps?.max_txpower != null)
			v = min(max(v, caps.min_txpower), caps.max_txpower);
		return '' + v;
	}

	if ((mode == 'medium' || mode == 'low') && caps?.max_txpower != null)
		return '' + max(caps.max_txpower - ((mode == 'low') ? 6 : 3), caps.min_txpower);

	return null;
}

// desired wifi-device options for one controller radio; null to leave
// the radio alone, { error } if the controller setting can't be applied
function radio_wanted(systemcfg, pfx, cur, caps) {
	const chan = systemcfg[pfx + 'channel'];
	if (chan == null)
		return null;

	const valid = length(caps?.channels) ? caps.channels : null;
	let want = {};

	if (chan == 'auto' || chan == '0') {
		want.channel = 'auto';
		want.channels = null;

		const blk = map(filter(split(systemcfg[pfx + 'blklst'] ?? '', ','), length), c => +c);
		if (length(blk) && valid) {
			const allowed = filter(valid, c => !(c in blk));
			if (length(allowed))
				want.channels = map(allowed, c => '' + c);
		}

		want.acs_exclude_dfs = (systemcfg[pfx + 'acsdfs'] == 'disabled') ? '1' : null;
	} else {
		if (!match(chan, /^[0-9]+$/) || (valid && !(+chan in valid)))
			return { error: `channel ${chan} is not available` };

		want.channel = chan;
		want.channels = null;
		want.acs_exclude_dfs = null;
	}

	const w = match(systemcfg[pfx + 'ieee_mode'] ?? '', /(20|40|80|160|320)(plus|minus)?$/);
	const fam = match(cur.htmode ?? '', /^([A-Z]+)[0-9]/);
	if (w && fam && HT_MAX_WIDTH[fam[1]] && +w[1] <= HT_MAX_WIDTH[fam[1]])
		want.htmode = fam[1] + w[1];

	if (systemcfg[pfx + 'txpower'] != null || systemcfg[pfx + 'txpower_mode'] != null)
		want.txpower = txpower_wanted(systemcfg, pfx, caps);

	return want;
}

function sync_radios(API, cfg, systemcfg) {
	if (!(cfg.radio_sync in TRUE_VALUES))
		return false;

	let idxs = [];
	for (let key in keys(systemcfg)) {
		const m = match(key, /^radio\.([0-9]+)\.phyname$/);
		if (m)
			push(idxs, +m[1]);
	}
	sort(idxs);

	const ctx = uci.cursor();
	const wstat = API.ubus.call('network.wireless', 'status');
	let changed = false;

	for (let idx in idxs) {
		const pfx = `radio.${idx}.`;
		const radio = systemcfg[pfx + 'phyname'];
		const cur = ctx.get_all('wireless', radio);

		if (cur?.['.type'] != 'wifi-device' || systemcfg[pfx + 'status'] == 'disabled')
			continue;

		const want = radio_wanted(systemcfg, pfx, cur, device_caps(API, wstat, radio));
		if (!want)
			continue;

		if (want.error) {
			warn(`unifi: ${radio}: ${want.error}, keeping the local channel\n`);
			continue;
		}

		for (let opt, val in want) {
			if (sprintf('%J', cur[opt] ?? null) == sprintf('%J', val))
				continue;

			API.dbg(`unifi: ${radio}: ${opt} ${cur[opt] ?? '-'} -> ${val ?? '-'}\n`);
			if (val == null)
				ctx.delete('wireless', radio, opt);
			else
				ctx.set('wireless', radio, opt, val);
			changed = true;
		}
	}

	if (!changed)
		return false;

	ctx.commit('wireless');
	warn('unifi: radio settings updated from controller\n');
	system('wifi reload');
	return true;
}

function on_system_cfg(API, cfg, systemcfg) {
	vap_id = {};

	let idx = 1;
	while (true) {
		const ssid = systemcfg[`wireless.${idx}.ssid`];
		if (!ssid)
			break;

		const id = systemcfg[`wireless.${idx}.id`];
		if (id)
			vap_id[ssid] = id;

		idx++;
	}

	sync_wpa_psks(API, cfg, systemcfg);
	sync_radios(API, cfg, systemcfg);
	require('unifi.sshkeys').sync(API, cfg, systemcfg);
}

function ipv4_to_int(ip) {
    let p = split(ip, ".");
    return (p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3];
}

function ip_on_iface(target, iface_ip, masklen) {
    let mask = masklen == 0 ? 0 : (0xffffffff << (32 - masklen));
    return (ipv4_to_int(target) & mask) == (ipv4_to_int(iface_ip) & mask);
}

function read_board_json() {
	const raw = readfile('/etc/board.json');
	if (!raw)
		return null;

	// board.json is generated by OpenWrt itself from the target's DTS /
	// board config, so malformed JSON here would indicate something is
	// badly wrong with the system rather than a normal runtime
	// condition -- but don't let a parse failure take the whole inform
	// down, just fall back to sysfs-based detection.
	try {
		return json(raw);
	} catch (e) {
		return null;
	}
}

// board.json can point network.wan.device (and, in principle, entries in
// network.*.ports) at a VLAN sub-interface such as "wan.6", used by ISPs
// that require 802.1Q-tagged uplinks. That's not a physical netdev by
// itself -- the physical port is the part before the dot -- so strip it
// before using the name as a port_table entry.
function strip_vlan_suffix(dev) {
	return split(dev, '.')[0];
}

// Reads the physical port list and WAN device out of /etc/board.json,
// which OpenWrt generates from the DTS/board config and is therefore a
// much more reliable source for "what are the real physical ports" than
// trying to infer it from sysfs (DSA conduit interfaces, VLANs, bridges,
// etc. all have to be guessed at and reasoned about there). Returns empty
// results if board.json is missing, unreadable, or lacks a usable
// 'network' section (e.g. some non-standard or virtual targets); callers
// are expected to fall back to sysfs-based detection in that case.
//
// 'exclude' is an optional set (object used as a set) of device names to
// skip when building the port list -- used to filter out legacy switch
// CPU trunk devices (see board_switch_ports() below), since on a board
// with a 'switch' section, network.*.device/ports point at those trunks
// rather than at standalone physical jacks, and listing them as ports
// would be wrong (and, worse, all_devices[] may not even carry entries
// for them the way it does for genuine port netdevs, so treating them as
// ports can crash get_port_obj() downstream). wan_dev is still recorded
// even when it names an excluded trunk device, since that's harmless and
// still useful as a last-resort fallback.
function board_network_info(board, exclude) {
	let ports = [];
	let seen = {};
	let wan_dev;

	if (board && board.network) {
		for (let name, iface in board.network) {
			if (iface.ports) {
				for (let p in iface.ports) {
					p = strip_vlan_suffix(p);

					if (exclude && exclude[p])
						continue;

					if (!seen[p]) {
						seen[p] = true;
						push(ports, p);
					}
				}
			}

			if (iface.device) {
				const dev = strip_vlan_suffix(iface.device);

				if (name == 'wan')
					wan_dev = dev;

				if (exclude && exclude[dev])
					continue;

				if (!seen[dev]) {
					seen[dev] = true;
					push(ports, dev);
				}
			}
		}
	}

	return { ports, wan_dev };
}

// Reads legacy swconfig switch topology out of /etc/board.json's 'switch'
// section, used on boards that predate DSA (e.g. the Archer C7 v2). Each
// switch lists every port by number; entries carrying a 'device' field
// are the switch's internal CPU-facing link for a role (e.g. the tagged
// VLAN trunk into eth0/eth1 on a switch chip with multiple CPU MACs) --
// not a physical jack -- so those are excluded, leaving only the
// externally-accessible ports a cable can actually be plugged into.
// 'role' == 'wan' entries are also collected separately so the uplink
// port can be identified directly instead of falling back to "last port
// enumerated". The excluded trunk device names are also returned, so
// callers can keep board_network_info() from mistaking them for
// standalone physical ports (see its 'exclude' parameter above).
function board_switch_ports(board) {
	let sw_ports = {};
	let sw_wan_ports = {};
	let trunk_devices = {};

	if (board && board.switch) {
		for (let sw_name, sw in board.switch) {
			let nums = [];
			let wan_nums = [];

			for (let port in sw.ports) {
				if (port.device) {
					trunk_devices[port.device] = true;
					continue;
				}

				push(nums, port.num);

				if (port.role == 'wan')
					push(wan_nums, port.num);
			}

			if (length(nums)) {
				sort(nums);
				sw_ports[sw_name] = nums;
			}

			if (length(wan_nums))
				sw_wan_ports[sw_name] = wan_nums;
		}
	}

	return { ports: sw_ports, wan_ports: sw_wan_ports, trunk_devices };
}

function init(API, cfg) {
	let netdev;

	const ifaces = API.ubus.call('network.interface', 'dump');
	const all_devices = API.ubus.call('network.device', 'status');

	let mask = -1;
	for (let iface in ifaces.interface) {
		let gateway;

		for (let route in iface.route) {
			if (route.mask > mask && ip_on_iface(cfg.inform_ip, route.target, route.mask)) {
				gateway = route.nexthop;
				mask = route.mask;
			}		
		}

		for (let ip in iface["ipv4-address"]) {
			if (ip.mask > mask && ip_on_iface(cfg.inform_ip, ip.address, ip.mask)) {
				cfg.ip = ip.address;
				mask = ip.mask;
				gateway = null;
				netdev = iface.device;
			} else if (gateway && ip_on_iface(gateway, ip.address, ip.mask)) {
				cfg.ip = ip.address;
				gateway = null;
				netdev = iface.device;
			}
		}
	}

	if (!cfg.mac)
		// ubus reports the wrong MAC for this interface, so read it
		// directly from the network device instead.
		cfg.mac = trim(readfile('/sys/class/net/' + netdev + '/address'));

	const board = read_board_json();
	// Computed before board_network_info() so its trunk device names
	// (network.*.device entries that are actually the switch's internal
	// CPU-facing trunks, not standalone physical jacks -- e.g. the C7's
	// eth0/eth1) can be excluded from the generic port list below.
	const board_sw = board_switch_ports(board);
	const board_net = board_network_info(board, board_sw.trunk_devices);

	if (!cfg.uplink_dev) {
		if (board_net.wan_dev)
			cfg.uplink_dev = board_net.wan_dev;
		else if (all_devices.wan)
			cfg.uplink_dev = 'wan';
		else {
			while (1) {
				let dev = all_devices[netdev];

				if (dev['bridge-members']) {
					let member;
					// Tracks whether we descended into a wired bridge member
					// this iteration. Without this flag, an empty
					// bridge-members array (or one containing only wlan*
					// entries) would leave `member` unset/falsy after the
					// for-in loop and never break out, spinning forever on
					// the same netdev.
					let found = false;

					for (member in dev['bridge-members']) {
						if (substr(member, 0, 4) == 'wlan')
							continue;

						netdev = member;
						found = true;
						break;
					}

					if (!found)
						break;

				} else if (dev.parent) {
					netdev = dev.parent;

				} else {
					break;

				}
			}
			cfg.uplink_dev = netdev;
		}
	}

	if (length(board_net.ports)) {
		// Preferred path: board.json already enumerates every physical
		// port (network.*.ports and network.*.device across lan, wan,
		// and any other defined interfaces), so just use it directly
		// rather than re-deriving the same information from sysfs.
		cfg.phys_ports = board_net.ports;
		sort(cfg.phys_ports);
		API.dbg(`Using board.json for port detection: ${cfg.phys_ports}\n`);

	} else if (length(board_sw.ports)) {
		// board_net.ports came back empty, but board.json *did* give us
		// a valid 'switch' section -- i.e. this is a legacy swconfig
		// board (like the C7) where the physical ports live in
		// cfg.sw_ports, not here, and network.*.device just names the
		// switch's internal CPU trunk(s). That's a legitimate "no ports
		// to report here" result, not a failure, so leave phys_ports
		// empty rather than falling through to the sysfs fallback below
		// -- which has no notion of board.json's switch/trunk structure
		// and would happily re-detect those trunk devices as if they
		// were standalone physical ports (which is exactly the bug this
		// branch exists to avoid).
		cfg.phys_ports = [];

	} else {
		// Fallback for boards without a usable board.json 'network'
		// section (missing file, parse failure, or a non-standard
		// target). Re-derive the physical port list from sysfs.
		//
		// Pass 1: enumerate every netdev and pick out the DSA switch
		// ports (phys_switch_id present) -- these are unambiguously
		// physical. Keep a plain list of every entry seen too, since
		// ucode's directory iterator is single-pass and pass 2 below
		// needs to revisit the same entries once the DSA ports (if any)
		// are known.
		cfg.phys_ports = [];
		let seen_netdevs = [];
		let dir = opendir('/sys/class/net');
		let entry;

		if (dir) {
			while ((entry = dir.read())) {
				if (entry == '.' || entry == '..')
					continue;

				push(seen_netdevs, entry);

				if (readfile(`/sys/class/net/${entry}/phys_switch_id`))
					push(cfg.phys_ports, entry);
			}
			dir.close();
		}

		// Pass 2: pick up standalone physical NICs that aren't DSA
		// switch ports (e.g. a discrete WAN port on its own MAC/PHY).
		// Has to run after pass 1 finishes, because the DSA conduit
		// (master) interface -- e.g. 'eth0' feeding the switch chip on
		// many SoCs -- is itself a real hardware netdev with a
		// 'device' symlink and no DEVTYPE, and would otherwise be
		// indistinguishable from a genuine standalone physical port.
		//
		// The kernel's generic upper/lower device-stacking sysfs links
		// (the same mechanism used for VLANs, bridges, and bonds)
		// expose the conduit relationship: the conduit shows an
		// 'upper_<port>' entry for each DSA slave port layered on top
		// of it. Used here to exclude it, now that pass 1 has given us
		// the full list of DSA ports to check against.
		for (let candidate in seen_netdevs) {
			if (candidate in cfg.phys_ports)
				continue;

			if (access(`/sys/class/net/${candidate}/phy80211`))
				continue;

			const uevent = readfile(`/sys/class/net/${candidate}/uevent`);
			let has_devtype = false;
			if (uevent) {
				for (let line in split(uevent, '\n')) {
					if (substr(line, 0, 8) == 'DEVTYPE=') {
						has_devtype = true;
						break;
					}
				}
			}
			if (has_devtype)
				continue;

			if (!access(`/sys/class/net/${candidate}/device`))
				continue;

			let is_dsa_conduit = false;
			for (let port in cfg.phys_ports) {
				if (access(`/sys/class/net/${candidate}/upper_${port}`)) {
					is_dsa_conduit = true;
					break;
				}
			}
			if (is_dsa_conduit)
				continue;

			push(cfg.phys_ports, candidate);
		}

		sort(cfg.phys_ports);

		if (length(cfg.phys_ports))
			API.dbg(`Detected physical ports via sysfs fallback: ${cfg.phys_ports}\n`);
	}

	cfg.sw_ports = {};
	for (let idx = 1; idx <= 16; idx++) {
		const swport = cfg['swport' + idx];
		if (!swport)
			break;
		
		const comp = split(swport, ' ');
		if (length(comp) < 2)
			continue;

		if (!cfg.sw_ports[comp[0]])
			cfg.sw_ports[comp[0]] = [];

		push(cfg.sw_ports[comp[0]], +comp[1]);
	}

	// If nothing was explicitly configured via swportN, derive the
	// switch port list from board.json instead -- same idea as the DSA
	// port detection above: board.json is generated by OpenWrt from the
	// board config and is a more reliable source than requiring someone
	// to hand-enumerate ports in cfg. (board_sw was already computed
	// earlier in this function, before board_network_info(), so its
	// trunk device names could be used to filter the generic port list.)
	if (!length(cfg.sw_ports)) {
		if (length(board_sw.ports)) {
			cfg.sw_ports = board_sw.ports;
			cfg.sw_wan_ports = board_sw.wan_ports;
			API.dbg(`Using board.json for switch port detection: ${cfg.sw_ports}\n`);
		}
	}

    return true;
}

// Maps a ubus wireless band string to the UniFi inform radio-type token.
//
// NOTE: the '6g' branch is UNVERIFIED. I don't have a real UniFi 6E device
// (e.g. U6+ or similar) to capture a genuine inform payload from, so I can't
// confirm what radio-type token / capability flags the controller actually
// expects for 6GHz. 'na' is used here as a conservative fallback purely so
// a 6GHz radio doesn't get silently mis-tagged as 2.4GHz ('ng'), which was
// the original bug. Before relying on this in production against a real
// UniFi controller, capture an inform from genuine 6E hardware (or find a
// documented reference) and correct this mapping.
function band_to_radio_type(band) {
	switch (band) {
		case '5g':
			return 'na';
		case '6g':
			return 'na'; // TODO: unverified, see note above
		default:
			return 'ng';
	}
}

/* ---------------------------------------------------------------------- */
/* neighbour scan                                                         */
/*                                                                        */
/* A full scan (iwinfo scan) leaves the operating channel for every       */
/* channel in one go: ~1.6s on 2.4GHz, ~20s on 5GHz with DFS, with client */
/* packet loss, and blocks the inform loop meanwhile. Instead, every      */
/* scan_interval seconds a short scan of the own channel plus the next    */
/* channel of a rotation is triggered (iw ... scan trigger, which doesn't */
/* wait), and its results are collected from the kernel's BSS list on the */
/* next cycle into a per-radio cache, which feeds scan_table. Each        */
/* off-channel visit is 110 TU, enough to hear one beacon, and scanning   */
/* pauses while the radio carries more than scan_max_load kbit/s.         */
/*                                                                        */
/*   option scan '0'            disable (default: enabled)                */
/*   option scan_interval '60'  seconds between two scans                 */
/*   option scan_max_load '5000'  kbit/s on the radio above which no scan */
/*                              is started                                */
/* ---------------------------------------------------------------------- */

let scan_state = {};    // ifname -> { idx, cache, pending, last, bytes, mandatory }

// TU per channel: more than one beacon interval (102.4 TU), as some
// networks (mesh backhauls, DFS channels) can only be heard by beacon.
// Once a minute this showed no client impact.
const SCAN_DWELL = 110;

function scan_enabled(cfg) {
	return !(cfg.scan in [ '0', 'false', 'no', 'off', 'disabled' ]);
}

function channel_to_freq(band, ch) {
	if (band == '2g')
		return ch == 14 ? 2484 : 2407 + 5 * ch;
	return 5000 + 5 * ch;
}

function freq_to_channel(f) {
	if (f == 2484)
		return 14;
	if (f < 3000)
		return int((f - 2407) / 5);
	if (f >= 5955)
		return int((f - 5950) / 5);
	return int((f - 5000) / 5);
}

// Only the lines parse_iw_scan() needs: the BSS line, all top-level
// fields (which also end a section) and three nested ones. The full dump
// is ~90 lines per BSS, which is slow to parse on a small CPU.
const SCAN_DUMP_FILTER = `grep -E '^BSS |^[[:space:]][^[:space:]]|\\* (secondary channel offset|channel width|center freq segment 1|Authentication suites|Pairwise ciphers):'`;

// BSS entries from (filtered) `iw dev X scan dump` output. Every line is
// split once at the first ':' and dispatched on its key, no regex per field.
function parse_iw_scan(out) {
	let list = [], e, section;

	for (let line in split(out ?? '', '\n')) {
		if (substr(line, 0, 4) == 'BSS ') {
			e = { bssid: lc(substr(line, 4, 17)), essid: '', signal: null, age: 0,
			      ht_sec: 0, vht_width: 0, vht_center: 0, sec: 'open', enterprise: false, ccmp: false };
			push(list, e);
			section = null;
			continue;
		}

		const c = index(line, ':');
		if (!e || c < 0)
			continue;

		const key = trim(substr(line, 0, c));
		const val = trim(substr(line, c + 1));

		if (substr(line, 0, 2) != '\t\t') {
			section = null;
			switch (key) {
			case 'freq':      e.freq = int(+val); break;
			case 'signal':    e.signal = int(+split(val, ' ')[0]); break;
			case 'last seen': e.age = int(+split(val, ' ')[0] / 1000); break;
			case 'SSID':      e.essid = val; break;
			case 'capability':
				if (e.sec == 'open' && index(val, 'Privacy') >= 0)
					e.sec = 'wep';
				break;
			case 'WPA':
				if (e.sec in [ 'open', 'wep' ])
					e.sec = 'wpa';
				break;
			case 'RSN':
				if (e.sec != 'wpa3')
					e.sec = 'wpa2';
				section = key;
				break;
			case 'HT operation':
			case 'VHT operation':
				section = key;
				break;
			}
		}
		else if (section == 'HT operation' && key == '* secondary channel offset')
			e.ht_sec = (val == 'above') ? 1 : (val == 'below') ? -1 : 0;
		else if (section == 'VHT operation' && key == '* channel width')
			e.vht_width = int(+split(val, ' ')[0]);
		else if (section == 'VHT operation' && key == '* center freq segment 1')
			e.vht_center = int(+val);
		else if (section == 'RSN' && key == '* Authentication suites') {
			if (index(val, 'SAE') >= 0)
				e.sec = 'wpa3';
			if (index(val, '802.1X') >= 0)
				e.enterprise = true;
		}
		else if (section == 'RSN' && key == '* Pairwise ciphers' && index(val, 'CCMP') >= 0)
			e.ccmp = true;
	}

	return filter(list, x => x.freq && x.signal != null);
}

const SECURITY_NAME = { open: 'Open', wep: 'WEP', wpa: 'WPA', wpa2: 'WPA2', wpa3: 'WPA3' };

// The controller drops scan entries older than its inform interval + 10s
// (100s by default) and only stores those younger than 30s. A real AP
// rescans all channels that often; with the rotation here a channel comes
// around only every few minutes, so the age of a cached entry is reported
// as at most this. Networks that are gone still expire from the cache.
const SCAN_REPORT_MAX_AGE = 25;

// scan_table entry in the format of a real UniFi AP. The controller derives
// last_seen from 'age'.
function scan_entry(e, band, noise, now) {
	const age = min(now - e.last_seen, SCAN_REPORT_MAX_AGE);
	let bw = e.ht_sec ? 40 : 20;
	let center = e.freq + 10 * e.ht_sec;
	if (e.vht_width >= 1 && e.vht_center) {
		bw = (e.vht_width == 1) ? 80 : 160;
		center = (e.freq < 3000) ? center : 5000 + 5 * e.vht_center;
	}

	let security = SECURITY_NAME[e.sec];
	if (e.sec in [ 'wpa', 'wpa2', 'wpa3' ])
		security += (e.enterprise ? '-Enterprise' : '-Personal') + (e.ccmp ? ' (AES/CCMP)' : '');

	return {
		age,
		band: band_to_radio_type(band),
		bssid: e.bssid,
		essid: e.essid,
		channel: freq_to_channel(e.freq),
		freq: e.freq,
		center_freq: center,
		bw,
		signal: e.signal,
		noise,
		rssi: max(0, e.signal - noise),
		rssi_age: age,
		security,
		is_adhoc: false,
		is_ubnt: false,
	};
}

// One scan step for a radio; returns its scan_table from the cache.
// radio_bytes: rx+tx bytes of all its VAPs, for the load check.
function scan_radio(API, cfg, ifname, band, op_channel, op_noise, caps, radio_bytes) {
	const now = time();
	const interval = +(cfg.scan_interval ?? 60) || 60;
	let st = scan_state[ifname];
	if (!st)
		st = scan_state[ifname] = { idx: 0, cache: {}, pending: false, last: 0, mandatory: true };

	// rotation: the radio's channels of this band
	const rot = filter(caps?.channels ?? [], c => band == '2g' ? c <= 14 : (c >= 32 && c <= 177));

	// 1. results of the previous trigger
	if (st.pending) {
		for (let e in parse_iw_scan(cmd_output(`iw dev ${ifname} scan dump 2>/dev/null | ${SCAN_DUMP_FILTER}`))) {
			e.last_seen = now - e.age;
			st.cache[e.bssid] = e;
		}
		st.pending = false;
	}

	// 2. forget networks not seen for three rotations (at least 30 min)
	const ttl = max(1800, 3 * length(rot) * interval);
	for (let b, e in st.cache)
		if (now - e.last_seen > ttl)
			delete st.cache[b];

	// 3. next scan, unless it's not due yet or the radio is busy
	const kbps = (st.bytes != null && now > st.last) ? (radio_bytes - st.bytes) * 8 / 1000 / (now - st.last) : 0;
	const max_load = +(cfg.scan_max_load ?? 5000);

	if (length(rot) && now - st.last >= interval) {
		if (st.bytes != null && kbps > max_load) {
			API.dbg('unifi: %s: %d kbit/s, scan postponed\n', ifname, kbps);
		} else {
			const target = rot[st.idx++ % length(rot)];
			let chans = uniq([ +op_channel, target ]);
			chans = filter(chans, c => c > 0);
			const freqs = join(' ', map(chans, c => channel_to_freq(band, c)));
			const opts = st.mandatory ? ` duration ${SCAN_DWELL} duration-mandatory` : '';

			let err = trim(cmd_output(`iw dev ${ifname} scan trigger ap-force flush freq ${freqs}${opts} 2>&1`));
			if (length(err) && st.mandatory && match(err, /\((-95|-22)\)/)) {
				// driver without a settable dwell time: use its default
				st.mandatory = false;
				err = trim(cmd_output(`iw dev ${ifname} scan trigger ap-force flush freq ${freqs} 2>&1`));
			}

			if (length(err))
				API.dbg('unifi: %s: scan of %s failed: %s\n', ifname, freqs, err);
			else
				st.pending = true;
		}
		st.last = now;
		st.bytes = radio_bytes;
	}

	const noise = (op_noise && op_noise < 0) ? op_noise : -95;
	return map(sort(values(st.cache), (a, b) => b.signal - a.signal), e => scan_entry(e, band, noise, now));
}

function clamp(v, lo, hi) {
        if (v < lo) return lo;
        if (v > hi) return hi;
        return v;
}

function roundi(v) {
        return int(v + 0.5);
}

function snr_score(signal, noise) {
        let snr = signal - noise;
        let score;

        if (snr < 10)
                score = snr / 10 * 20;               //  0-20   poor
        else if (snr < 20)
                score = 20 + (snr - 10) / 10 * 40;    // 20-60   fair
        else if (snr < 30)
                score = 60 + (snr - 20) / 10 * 30;    // 60-90   good
        else
                score = 90 + (snr - 30) / 10 * 10;    // 90-100  excellent, caps at 40dB

        return clamp(score, 0, 100);
}

function retry_score(retries, failed, packets) {
        let total = packets + retries + failed;
        if (total == 0)
                return 100;

        let ratio = (retries + failed) / total * 100;
        let score;

        if (ratio < 5)
                score = 100 - (ratio / 5) * 10;         // 90-100  normal probing noise
        else if (ratio < 15)
                score = 90 - (ratio - 5) / 10 * 20;      // 70-90   still fine
        else if (ratio < 30)
                score = 70 - (ratio - 15) / 15 * 30;     // 40-70   worth watching
        else
                score = 40 - (ratio - 30) / 30 * 40;     // 0-40    genuinely bad

        return clamp(score, 0, 100);
}

function satisfaction(sta) {
        let s = snr_score(sta.signal, sta.noise);
        let r = retry_score(sta.tx.retries, sta.tx.failed, sta.tx.packets);

        return roundi(0.3 * s + 0.7 * r);
}

function mhz_to_chwidth(mhz) {
        switch (mhz) {
                case 20:  return 0;
                case 40:  return 1;
                case 80:  return 2;
                case 160: return 3;
                // 80+80 isnt distinguishable from 160 by mhz alone;
                // if your driver/iw output exposes it separately, map that instead
                default:  return -1; // unknown/unreported
        }
}

/* ---------------------------------------------------------------------- */
/* radio and VAP statistics                                               */
/*                                                                        */
/* Channel utilization from the survey of the operating channel (busy,    */
/* receive and transmit time), as a real AP reports it in athstats: total */
/* busy time, own transmit time, receive time of the own clients          */
/* (estimated from their received bytes and rate) and the rest as         */
/* interference. Per VAP the average client signal and TX retries,        */
/* attempts and drops, accumulated from per-station deltas so that the    */
/* counters don't drop when a client leaves.                              */
/* ---------------------------------------------------------------------- */

let survey_prev = {};   // ifname -> { active, busy, rx, tx } (ms)
let sta_prev = {};      // mac -> { retries, packets, failed, rx_bytes }
let vap_counters = {};  // vap name -> { tx_retries, wifi_tx_attempts, wifi_tx_dropped }

// Cumulative counters of the operating channel from `iw survey dump`.
function read_survey(ifname) {
	let cur, out = {};
	for (let line in split(cmd_output(`iw dev ${ifname} survey dump 2>/dev/null`), '\n')) {
		if (index(line, 'frequency:') >= 0) {
			cur = index(line, '[in use]') >= 0;
			continue;
		}
		if (!cur)
			continue;
		const c = index(line, ':');
		if (c < 0)
			continue;
		const key = trim(substr(line, 0, c)), val = int(+split(trim(substr(line, c + 1)), ' ')[0]);
		switch (key) {
		case 'channel active time':   out.active = val; break;
		case 'channel busy time':     out.busy = val; break;
		case 'channel receive time':  out.rx = val; break;
		case 'channel transmit time': out.tx = val; break;
		}
	}
	return (out.active != null && out.busy != null) ? out : null;
}

// athstats-style channel utilization in % since the previous call, or null.
// self_rx_ms: estimated receive airtime of the own clients in that period.
function channel_utilization(ifname, self_rx_ms) {
	const cur = read_survey(ifname);
	if (!cur)
		return null;

	let prev = survey_prev[ifname];
	survey_prev[ifname] = cur;
	if (!prev)
		return null;

	// some drivers reset the counters (e.g. after a scan): the current
	// values are then the delta since the reset
	if (cur.active < prev.active || cur.busy < prev.busy)
		prev = { active: 0, busy: 0, rx: 0, tx: 0 };

	const active = cur.active - prev.active;
	if (active <= 0)
		return null;

	const pct = v => min(100, max(0, int(100 * v / active + 0.5)));
	const busy = cur.busy - prev.busy;
	const tx = max(0, (cur.tx ?? 0) - (prev.tx ?? 0));
	const rx = max(0, (cur.rx ?? 0) - (prev.rx ?? 0));
	const self_rx = min(rx, self_rx_ms);

	const total = pct(busy), self_tx = pct(tx), self_rxp = pct(self_rx);
	return {
		cu_total: total,
		cu_self_tx: self_tx,
		cu_self_rx: self_rxp,
		cu_interf: max(0, total - self_tx - self_rxp),
	};
}

// Per-station deltas since the previous call: { retries, attempts, failed,
// rx_ms } (rx_ms: airtime estimate of the received data).
function sta_deltas(sta) {
	const mac = lc(sta.mac);
	const cur = {
		retries: sta.tx?.retries ?? 0,
		packets: sta.tx?.packets ?? 0,
		failed: sta.tx?.failed ?? 0,
		rx_bytes: sta.rx?.bytes ?? 0,
	};
	let prev = sta_prev[mac];
	sta_prev[mac] = cur;

	// First sight: a station that connected only now counts from zero, one
	// that was connected before (e.g. across a daemon restart) only sets the
	// baseline, or its whole history would show up as one burst.
	if (!prev)
		prev = ((sta.connected_time ?? 0) > 120) ? cur : { retries: 0, packets: 0, failed: 0, rx_bytes: 0 };
	else if (cur.packets < prev.packets || cur.rx_bytes < prev.rx_bytes)   // reassociated
		prev = { retries: 0, packets: 0, failed: 0, rx_bytes: 0 };

	const d = {
		retries: max(0, cur.retries - prev.retries),
		attempts: max(0, cur.packets - prev.packets) + max(0, cur.retries - prev.retries),
		failed: max(0, cur.failed - prev.failed),
		rx_ms: 0,
	};
	const rate = sta.rx?.rate;          // kbit/s
	if (rate > 0)
		d.rx_ms = (cur.rx_bytes - prev.rx_bytes) * 8 / rate;   // bits / (kbit/s) = ms
	return d;
}

function get_wireless_data(API, cfg, all_devices, with_scan) {
	let vap_table = [];
	let radio_table = [];
	const wstat = API.ubus.call('network.wireless', 'status');

	let total_satisfaction = 0;

	for (let radio, radio_data in wstat) {
		const band = radio_data.config.band;
		const radio_type = band_to_radio_type(band);
		const htmode = match(radio_data.config.htmode, /[0-9]+/);

		// operating channel and transmit power, which differ from the
		// config with 'auto' / no txpower set
		let op_channel = radio_data.config.channel;
		let op_txpower = radio_data.config.txpower;
		let op_noise;
		for (let iface in radio_data.interfaces) {
			const info = API.ubus.call('iwinfo', 'info', { device: iface.ifname ?? iface.config.ifname });
			if (info?.channel) {
				op_channel = info.channel;
				op_txpower = info.txpower ?? op_txpower;
				op_noise = info.noise;
				break;
			}
		}

		let radio_satisfaction = 0;
		let num_radio_satisfaction = 0;

		// Tracks whether this radio produced any VAPs, so the with_scan
		// check below is scoped to this radio instead of the cumulative
		// vap_table across all radios processed so far.
		let radio_vap_count = 0;
		let radio_bytes = 0;    // rx+tx of all VAPs, for the scan load check
		let radio_self_rx_ms = 0;

		for (let iface in radio_data.interfaces) {
			const ifname = iface.config.ifname;

			let sta_table = [];
			let num_sta = 0;

			let wifi_ifaces = [ iface.config.ifname ];
			for (let vlan in iface.vlans)
				push(wifi_ifaces, vlan.ifname);

			let iface_satisfaction = 0;
			let signal_sum = 0;
			let vc = vap_counters[ifname] ??= { tx_retries: 0, wifi_tx_attempts: 0, wifi_tx_dropped: 0 };

			for (let wifi_iface in wifi_ifaces) {
				const assoc =  API.ubus.call('iwinfo', 'assoclist', {'device': wifi_iface});
				if (!assoc)
					continue;

				for (let sta in assoc.results) {
					let sta_satisfaction = satisfaction(sta);
					iface_satisfaction += sta_satisfaction;
					signal_sum += sta.signal;

					const d = sta_deltas(sta);
					vc.tx_retries += d.retries;
					vc.wifi_tx_attempts += d.attempts;
					vc.wifi_tx_dropped += d.failed;
					radio_self_rx_ms += d.rx_ms;

					let sta_item = {
						mac: lc(sta.mac),
						authorized: sta.authorized,
						signal: sta.signal,
						noise: sta.noise,
						satisfaction: sta_satisfaction,
						is_11a: band == '5g' || band == '6g',
						is_11n: false,
						is_11ac: false,
						is_11ax: false,
						is_11be: false,
					};

					for (let dir in ['rx', 'tx']) {
						let sta_data = sta[dir];

						if (sta_data.rate)
							sta_item[dir + '_rate'] = sta_data.rate;

						if (sta_data.packets)
							sta_item[dir + '_packets'] = sta_data.packets;

						if (sta_data.bytes)
							sta_item[dir + '_bytes'] = sta_data.bytes;
						
						if (sta_data.ht)
							sta_item.is_11n = true;

						if (sta_data.vht)
							sta_item.is_11ac = true;

						if (sta_data.he)
							sta_item.is_11ax = true;

						if (sta_data.eht)
							sta_item.is_11be = true;
					}

					if (sta.tx.retries && sta.tx.packets) {
						sta_item.tx_retries = sta.tx.retries;
						sta_item.wifi_tx_attempts = sta.tx.packets + sta.tx.retries;
						sta_item.wifi_tx_dropped = sta.tx.failed;
					}

					if (sta.tx.mhz)
						sta_item.chwidth = mhz_to_chwidth(sta.tx.mhz);

					push(sta_table, sta_item);
					num_sta++;
				}
			}

			iface_satisfaction = num_sta ? iface_satisfaction / num_sta : 100;
			radio_satisfaction += iface_satisfaction;
			num_radio_satisfaction++;

            let id = vap_id[iface.config.ssid];
            if (!id)
                continue;

			let vap = {
				name: ifname,
				essid: iface.config.ssid,
				id: id,
				channel: op_channel,
				tx_power: op_txpower,
				radio: radio_type,
				num_sta: num_sta,
				num_satisfaction_sta: num_sta,
				satisfaction: iface_satisfaction,
				tx_retries: vc.tx_retries,
				wifi_tx_attempts: vc.wifi_tx_attempts,
				wifi_tx_dropped: vc.wifi_tx_dropped,
				state: 'RUN',
				sta_table: sta_table,
				rx_packets: 0,
				rx_bytes: 0,
				rx_dropped: 0,
				tx_packets: 0,
				tx_bytes: 0,
				tx_dropped: 0,
			};

			const ifname_len = length(ifname);
			for (let ifdata in all_devices) {
				if (substr(ifdata, 0, ifname_len) == ifname) {
					let stats = all_devices[ifdata].statistics;
					vap.rx_packets += stats.rx_packets;
					vap.rx_bytes += stats.rx_bytes;
					vap.rx_dropped += stats.rx_dropped;
					vap.tx_packets += stats.tx_packets;
					vap.tx_bytes += stats.tx_bytes;
					vap.tx_dropped += stats.tx_dropped;
				}
			}

			if (htmode)
				vap.ht = +htmode[0];

			// the controller averages this weighted by num_sta
			if (num_sta)
				vap.avg_client_signal = int(signal_sum / num_sta);

			push(vap_table, vap);
			radio_vap_count++;
			radio_bytes += vap.rx_bytes + vap.tx_bytes;
		}


		radio_satisfaction = num_radio_satisfaction ? radio_satisfaction / num_radio_satisfaction : 100;
		total_satisfaction += radio_satisfaction;

		let wstat_radio = {};
		wstat_radio[radio] = radio_data;
		const caps = device_caps(API, wstat_radio, radio);

		// The controller derives the radio description ("2x2 WiFi 4") from
		// nss and the selectable channels from has_dfs/has_fccdfs (without
		// them only the non-DFS channels are offered).
		let radio_item = {
			antenna_id: 0,
			antenna_gain: 0,
			builtin_ant_gain: 0,
			builtin_antenna: true,
			current_antenna_gain: 0,
			max_txpower: caps?.max_txpower ?? +radio_data.config.txpower,
			min_txpower: caps?.min_txpower ?? +radio_data.config.txpower,
			nss: caps?.nss ?? 1,
			name: radio,
			radio: radio_type,
			scan_table: [],
		};

		if (band != '2g') {
			radio_item.has_dfs = caps?.has_dfs ?? false;
			radio_item.has_fccdfs = radio_item.has_dfs;
		}

		// a real device only reports the flags that are set
		const is_11ac = caps ? has_htmode(caps, /^VHT/) : (band == '5g');
		const flags = {
			is_11ac,
			is_11ax: has_htmode(caps, /^HE/),
			is_11be: has_htmode(caps, /^EHT/),
			has_ht160: has_htmode(caps, /160$/),
		};
		for (let k, v in flags)
			if (v)
				radio_item[k] = true;

		// Supported 802.11 modes, matching a real UAP-IW-HD (ng: 10,
		// na: 21): 1 = a, 2 = b, 4 = n (5 GHz), 8 = n (2.4 GHz), 16 = ac
		radio_item.ieee_modes = (band == '2g')
			? 2 | (has_htmode(caps, /^HT/) || !caps ? 8 : 0)
			: 1 | (has_htmode(caps, /^HT/) || !caps ? 4 : 0) | (is_11ac ? 16 : 0);

		// Capability bitfields, defaulting to the values of a real
		// UAP-IW-HD (from mca-dump), overridable per radio type, e.g.
		// option radio_caps_na '...'. The controller uses them, together
		// with nss, for the radio description and the selectable channels.
		const RADIO_CAPS_DEFAULT = {
			ng: { radio_caps: 147476, radio_caps2: 11 },
			na: { radio_caps: 251805700, radio_caps2: 11 },
		};
		for (let k in [ 'radio_caps', 'radio_caps2' ]) {
			const v = cfg?.[`${k}_${radio_type}`] ?? RADIO_CAPS_DEFAULT[radio_type]?.[k];
			if (v != null)
				radio_item[k] = +v;
		}

		if (htmode)
			radio_item.ht = +htmode[0];

		// channel utilization; the controller takes cu_total/self_rx/self_tx
		// from athstats, cu_interf directly from the radio entry
		const cu = radio_vap_count ? channel_utilization(radio_data.interfaces[0].config.ifname, radio_self_rx_ms) : null;
		if (cu) {
			radio_item.athstats = { name: radio, ...cu };
			radio_item.cu_interf = cu.cu_interf;
		}

		if (with_scan && radio_vap_count && band in [ '2g', '5g' ])
			radio_item.scan_table = scan_radio(API, cfg, radio_data.interfaces[0].config.ifname,
				band, op_channel, op_noise, caps, radio_bytes);

		push(radio_table, radio_item);
	}

 	total_satisfaction = length(radio_table) ? total_satisfaction / length(radio_table) : 100;

	return {
		vap: vap_table,
		radio: radio_table,
		satisfaction: total_satisfaction,
	};
}

function get_port_obj(pi)
{
	const st = pi.statistics;
	let speed = 0;
	let full_duplex = false;
	if (pi.speed) {
		full_duplex = (substr(pi.speed, -1) == 'F');
		speed = int(pi.speed);
	}

	return {
		up: pi.carrier,
		is_uplink: false,

		autoneg: pi.autoneg,
		speed: speed,
		full_duplex: full_duplex,
		media: 'GE',

		tx_bytes: st.tx_bytes,
		tx_packets: st.tx_packets,
		tx_errors: st.tx_errors,
		tx_dropped: st.tx_dropped,

		rx_bytes: st.rx_bytes,
		rx_packets: st.rx_packets,
		rx_errors: st.rx_errors,
		rx_dropped: st.rx_dropped,
		rx_multicast: st.multicast,
	};
}

function mac_table_has(table, mac) {
	for (let entry in table)
		if (entry.mac == mac)
			return true;
	return false;
}

// Case-insensitive variant: swconfig's arl_table output and the bridge
// FDB don't agree on MAC case, and neither necessarily matches lldpcli.
function mac_table_has_ci(table, mac) {
	mac = lc(mac);
	for (let entry in (table || []))
		if (lc(entry.mac) == mac)
			return true;
	return false;
}

// Queries lldpd (if installed and running) for its current neighbors.
// Returns an array of { ifname, macs[] } -- one entry per neighbor, where
// ifname is the local interface lldpd heard it on and macs are the
// neighbor's chassis-id and port-id values when those are MAC addresses
// (chassis first, since that's normally the device's primary MAC).
// Returns null if lldpcli isn't available or produced nothing usable, so
// callers can treat "no LLDP" and "LLDP with no neighbors" the same way.
//
// Uses the 'json0' output format rather than 'json': plain 'json'
// collapses single-element lists into objects (so the structure changes
// depending on how many neighbors/ids there are), while json0 always
// emits arrays and can be walked uniformly.
function get_lldp_neighbors() {
	const p = popen('lldpcli -f json0 show neighbors 2>/dev/null');
	if (!p)
		return null;

	const raw = p.read('all');
	p.close();

	if (!raw || !length(trim(raw)))
		return null;

	let data;
	try {
		data = json(raw);
	} catch (e) {
		return null;
	}

	let neighbors = [];

	for (let lldp in (data?.lldp || [])) {
		for (let iface in (lldp?.interface || [])) {
			let macs = [];
			let seen = {};

			for (let section in [ iface.chassis, iface.port ]) {
				for (let s in (section || [])) {
					for (let id in (s?.id || [])) {
						if (id.type != 'mac' || !id.value)
							continue;

						const mac = lc(id.value);
						if (!seen[mac]) {
							seen[mac] = true;
							push(macs, mac);
						}
					}
				}
			}

			if (length(macs))
				push(neighbors, { ifname: iface.name, macs });
		}
	}

	return length(neighbors) ? neighbors : null;
}

// If LLDP neighbors are known, replace each port's learned MAC table
// with just the LLDP neighbor(s) attached to that port. A neighbor is
// attributed to a port when either:
//   - one of its LLDP MACs already appears in the port's MAC table
//     (bridge FDB or swconfig ARL), or
//   - lldpd received it directly on a netdev with the same name as the
//     port (DSA / discrete NIC ports, where lldpd runs per-port).
// The second case matters because LLDP frames are link-local and often
// trapped to the CPU without being learned, so the neighbor's MAC isn't
// guaranteed to be in the FDB/ARL at all. On swconfig boards lldpd only
// sees the CPU trunk (e.g. eth0), so there only the MAC match can work.
//
// Ports with no matching LLDP neighbor keep their original table.
function apply_lldp_neighbors(API, ports, neighbors) {
	if (!neighbors)
		return;

	for (let port in ports) {
		let table = [];
		let seen = {};

		for (let n in neighbors) {
			let hit = (n.ifname == port.name);

			if (!hit) {
				for (let mac in n.macs) {
					if (mac_table_has_ci(port.mac_table, mac)) {
						hit = true;
						break;
					}
				}
			}

			if (!hit)
				continue;

			for (let mac in n.macs) {
				if (!seen[mac]) {
					seen[mac] = true;
					push(table, { mac, static: false });
				}
			}
		}

		if (length(table)) {
			API.dbg(`LLDP: port '${port.name}' mac_table replaced with ${join(', ', keys(seen))}\n`);
			port.mac_table = table;
			port.mac_table_count = length(table);
		}
	}
}


function get_port_data(API, cfg, all_devices) {
	let ports = [];
	let idx = 1;
	let is_uplink = false;

	if (length(cfg.phys_ports)) {
    	const br_dump = rtnl.request(rtnl.const.RTM_GETNEIGH, rtnl.const.NLM_F_DUMP, { family: rtnl.const.AF_BRIDGE });
		for (let name in cfg.phys_ports) {
			let port = get_port_obj(all_devices[name]);

			port.mac_table = [];
			for (let entry in br_dump) {
				if (entry.dev == name
			  	    && (entry.state & rtnl.const.NUD_REACHABLE) 
				    && (entry.flags & rtnl.const.NTF_SELF)) 
					push(port.mac_table, {
						mac: entry.lladdr,
						static: false,
					})
			}
			port.mac_table_count = length(port.mac_table);

			port.name = name;
			port.port_idx = idx++;
			push(ports, port);
		}
	}

	if  (length(cfg.sw_ports)) {
		for (let sw in cfg.sw_ports) {
			let swports = cfg.sw_ports[sw];
			let port_map = {};
			let m;

			for (let portnr in swports) {
				const swc = popen(`swconfig dev ${sw} port ${portnr} get link 2>/dev/null`);
				if (swc) {
					for (let line = swc.read('line'); length(line); line = swc.read('line')) {
						let port = {
							name: sw + '_' + portnr,
							port_idx: idx++,
							media: 'GE',
							full_duplex: false,
							autoneg: true,
							mac_table: [],
							mac_table_count: 0,
						};

						for (let param in split(line, ' ')) {
							const items = split(param, ':');
							if (length(items) == 2) {
								if (items[0] == 'link')
									port.up = items[1] == 'up';
								else if (items[0] == 'speed')
									port.speed = int(items[1]);
							} else {
								if (param == 'full-duplex')
									port.full_duplex = true;
							}
						}

						push(ports, port);
						port_map[portnr] = port;
					}
				}
			}

		 	const swc = popen(`swconfig dev ${sw} get arl_table 2>/dev/null`);
			if (swc) {
				for (let line = swc.read('line'); length(line); line = swc.read('line')) {
					if ((m = match(line, /[^0-9]*([0-9]+).*MAC[ ]*([0-9a-fA-F\:]*)/)) != null) {
						let portnr = +m[1];
						let port = port_map[portnr];

						if (!port)
							continue;

						push(port.mac_table, {
							mac: m[2],
							static: false,
						});
						port.mac_table_count++;
					}
				}
				swc.close();
			}
		}
	}

	let uplink_port;

	if (length(ports)) {
		// 1) Prefer matching by name against cfg.uplink_dev (computed in
		// init() by walking the bridge/DSA parent chain, or from
		// board.json's network.wan.device). This only reliably matches
		// for the DSA/board.json path, since cfg.phys_ports entries
		// share their naming with all_devices/cfg.uplink_dev;
		// swconfig-derived port names (sw_N) never match a netdev name.
		for (let port in ports) {
			if (port.name == cfg.uplink_dev) {
				uplink_port = port;
				break;
			}
		}

		// 2) For swconfig boards, match against the wan-role port
		// board.json reported (see board_switch_ports() in init()),
		// since those port names (sw_N) can't be matched by netdev name.
		if (!uplink_port && cfg.sw_wan_ports) {
			for (let sw in cfg.sw_wan_ports) {
				if (uplink_port)
					break;

				for (let portnr in cfg.sw_wan_ports[sw]) {
					const wan_name = sw + '_' + portnr;

					for (let port in ports) {
						if (port.name == wan_name) {
							uplink_port = port;
							break;
						}
					}

					if (uplink_port)
						break;
				}
			}
		}

		if (!uplink_port) {
			API.dbg(`uplink_dev '${cfg.uplink_dev}' not found in port_table, falling back to last enumerated port '${ports[-1].name}'\n`);
			uplink_port = ports[-1];
		}
	} else {
		uplink_port = get_port_obj(all_devices[cfg.uplink_dev]);
		uplink_port.name = cfg.uplink_dev;
		uplink_port.port_idx = idx++,
		uplink_port.mac_table = [];
		uplink_port.mac_table_count = 0;
		push(ports, uplink_port)
	}

	// The UniFi controller UI expects the uplink port to be the last
	// entry in port_table -- move it there if it isn't already, then
	// renumber port_idx sequentially so it stays consistent with the
	// final array order (matching real UniFi hardware, where the
	// uplink is typically the highest-numbered port too).
	if (uplink_port != ports[-1]) {
		let reordered = [];
		for (let port in ports)
			if (port != uplink_port)
				push(reordered, port);
		push(reordered, uplink_port);
		ports = reordered;
	}

	let port_idx = 1;
	for (let port in ports)
		port.port_idx = port_idx++;

	uplink_port.is_uplink = true;

	// Narrow per-port MAC tables down to actual LLDP neighbors where
	// lldpd can identify them; ports without an LLDP match are left as-is.
	apply_lldp_neighbors(API, ports, get_lldp_neighbors());

    if (cfg.uplink_peer && !mac_table_has(uplink_port.mac_table, cfg.uplink_peer)) {
		push(uplink_port.mac_table, {
			mac: cfg.uplink_peer,
			static: false,
		});
		uplink_port.mac_table_count++;
	}

	return ports;
}

function collect_data(API, cfg, data) {
	const sysstats = API.ubus.call('system', 'info');
	const all_devices = API.ubus.call('network.device', 'status');

	const mem_total = sysstats.memory.total;
	const mem_free  = sysstats.memory.free + sysstats.memory.cached + sysstats.memory.buffered;
	const mem_used  = mem_total - mem_free;
	const mem_usage = math.round (1000.0 * mem_used / mem_total) / 10;

	data.fw_caps = 3892248383;
	data.fw2_caps = 134807552;
	data.hw_caps = 2048;
	data.wifi_caps = 22986461;
	data.wifi_caps2 = 8944;

    data['system-stats'] = { mem: mem_usage };
    data.sys_stats = {
        loadavg_1: sysstats.load[0] / 65536.0,
        loadavg_15: sysstats.load[1] / 65536.0,
        loadavg_5: sysstats.load[2] / 65536.0,
    };

	data.port_table = get_port_data(API, cfg, all_devices);

	const wdata = get_wireless_data(API, cfg, all_devices, scan_enabled(cfg));
	data.radio_table = wdata.radio;
	data.vap_table = wdata.vap;
	data.satisfaction = wdata.satisfaction;
}


return {
	defaults: {
		model: 'U6ENTIW',
        model_display: 'U6ENTIW',
        hostname: 'U6ENTIW',
	},

	init: init,
	collect_data: collect_data,
    on_system_cfg: on_system_cfg,
};
